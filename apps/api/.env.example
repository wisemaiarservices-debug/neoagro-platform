NEOAGRO_ENV=development
NEOAGRO_DEMO_MODE=true
NEOAGRO_ALLOWED_ORIGINS=http://localhost:3000

# Server-side only. Leave unset until NOVA Core ingestion is deployed and provisioned.
# Never use NEXT_PUBLIC_ prefixes or expose these values to the browser.
# Explicit opt-in. Keep false until Core identity, storage and live acceptance gates pass.
NOVA_CORE_INGESTION_ENABLED=false
NOVA_CORE_INGESTION_URL=
NOVA_CORE_ACCESS_CLIENT_ID=
NOVA_CORE_ACCESS_CLIENT_SECRET=
